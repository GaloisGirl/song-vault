---
layout: base.njk
title: Anna's Song Vault
---

<div class="max-w-4xl mx-auto mt-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-8 text-center">Welcome. Pick an era.</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {% for era in eras %}
        <a href="/era/{{ era.slug }}/" class="block group">
            <div class="bg-gray-200 aspect-square rounded-lg flex items-center justify-center text-gray-800 text-2xl font-semibold shadow-md transition-transform transform group-hover:scale-105 overflow-hidden">
                <div class="p-6 text-center">{{ era.name }}</div>
            </div>
            <p class="mt-4 text-gray-600 text-center">{{ era.description }}</p>
        </a>
        {% endfor %}
    </div>
</div>
