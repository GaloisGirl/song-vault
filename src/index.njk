---
layout: base.njk
title: Anna's Song Vault
---

<div class="max-w-4xl mx-auto mt-10">
    <h1 class="text-3xl font-bold text-zinc-300 mb-8 text-left drop-shadow-sm tracking-wide">Welcome. Pick an era.</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {% for era in eras %}
        <a href="/era/{{ era.slug }}/" class="block group">
            <div class="bg-zinc-800 border-2 border-zinc-700 aspect-square rounded-lg flex items-center justify-center shadow-lg transition-all transform group-hover:scale-105 overflow-hidden group-hover:border-zinc-400 group-hover:shadow-2xl relative group-hover:ring-4 group-hover:ring-zinc-600/50">
                {% if era.image %}
                <img src="{{ era.image }}" alt="{{ era.name }}" class="w-full h-full object-cover opacity-90 transition-opacity group-hover:opacity-100 mix-blend-lighten">
                {% else %}
                <div class="p-6 text-center text-zinc-300 text-2xl font-bold">{{ era.name }}</div>
                {% endif %}
            </div>
            <p class="mt-4 text-zinc-400 font-medium text-center text-lg">{{ era.description }}</p>
        </a>
        {% endfor %}
    </div>
</div>
