<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Song Vault") }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body class="bg-zinc-900 text-zinc-200 font-sans min-h-screen flex flex-col bg-fixed">
    <!-- Common Header -->
    <header class="bg-zinc-900 border-b border-zinc-800 shadow-md py-4">
        <div class="max-w-4xl mx-auto px-4 flex justify-between items-center">
            <a href="/" class="flex items-center space-x-3 text-zinc-300 transition-colors hover:text-zinc-100 drop-shadow-md">
                <span class="text-2xl font-bold tracking-wide">Anna's Song Vault</span>
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-4xl mx-auto px-4 py-8 w-full">
        {{ content | safe }}
    </main>

    <!-- Common Footer -->
    <footer class="bg-zinc-900 border-t border-zinc-800 text-zinc-300 py-6 mt-auto">
        <div class="max-w-4xl mx-auto px-4 text-left text-sm font-medium">
            <p>&copy; 2026 Anna Kosieradzka.</p>
        </div>
    </footer>
</body>
</html>
