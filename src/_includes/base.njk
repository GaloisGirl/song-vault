<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Song Vault") }}</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body class="bg-gray-50 text-gray-900 font-sans min-h-screen flex flex-col">
    <!-- Common Header -->
    <header class="bg-gray-200 shadow-md py-4">
        <div class="max-w-4xl mx-auto px-4 flex justify-between items-center">
            <a href="/" class="flex items-center space-x-3 text-gray-900 transition-opacity hover:opacity-80">
                <img src="/img/vault.png" alt="Vault Logo" class="h-12 w-auto object-contain">
                <span class="text-2xl font-bold tracking-wide">Song Vault</span>
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-4xl mx-auto px-4 py-8 w-full">
        {{ content | safe }}
    </main>

    <!-- Common Footer -->
    <footer class="bg-gray-800 text-gray-300 py-6 mt-auto">
        <div class="max-w-4xl mx-auto px-4 text-center text-sm">
            <p>&copy; 2026 Song Vault. Built with Eleventy and Tailwind CSS.</p>
        </div>
    </footer>
</body>
</html>
